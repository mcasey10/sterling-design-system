{
  "$meta": {
    "name": "Sterling",
    "version": "0.1.0",
    "description": "Source of truth for Sterling. Aliases use {collection-local variable name}, e.g. {neutral/50} refers to the Primitives variable neutral/50.",
    "aliasSyntax": "{primitive/name}"
  },

  "primitives": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F7F8FA",
      "100": "#EEF0F3",
      "200": "#DDE1E6",
      "300": "#C3C9D1",
      "400": "#9AA3AE",
      "500": "#6F7985",
      "600": "#535C67",
      "700": "#3B434C",
      "750": "#2A3038",
      "800": "#232930",
      "900": "#14181D"
    },
    "blue": {
      "50": "#EEF4FF",
      "75": "#E4EDFF",
      "100": "#D9E6FF",
      "200": "#B9CFFA",
      "300": "#8FB2F5",
      "400": "#6B9BF2",
      "500": "#2F6FEB",
      "600": "#1F5AD1",
      "700": "#1848AA",
      "800": "#153A85",
      "850": "#1D2F52",
      "900": "#1A2A4A"
    },
    "green": {
      "50": "#EBF7F0",
      "100": "#D1EEDD",
      "200": "#A6DDBE",
      "300": "#86D6AD",
      "400": "#4CC38A",
      "500": "#1F9D55",
      "600": "#147A45",
      "700": "#12663B",
      "800": "#0E4F2E",
      "900": "#12301F"
    },
    "amber": {
      "50": "#FFF6E5",
      "100": "#FFE9BF",
      "200": "#FDD38A",
      "300": "#F7BA4F",
      "400": "#EBA21F",
      "500": "#D98E04",
      "600": "#B07203",
      "700": "#8C5B03",
      "800": "#6B4602",
      "900": "#3A2A0E"
    },
    "red": {
      "50": "#FDEDEF",
      "100": "#FAD4D8",
      "200": "#F5AEB5",
      "300": "#F28B8F",
      "400": "#E0525E",
      "500": "#D93545",
      "600": "#C0263A",
      "700": "#9E1F30",
      "800": "#7A1824",
      "900": "#4A1A1F"
    },
    "coral": {
      "50": "#FBEDEA",
      "100": "#F8D8D1",
      "200": "#F9C2B8",
      "300": "#F59C8B",
      "400": "#F2705A",
      "500": "#E0553D",
      "600": "#BE3D2A",
      "700": "#A63726",
      "800": "#7A2A1D",
      "900": "#4A2019"
    }
  },

  "color": {
    "$modes": ["Light", "Dark"],
    "$notes": {
      "text/inverse": "Foreground for every solid fill (accent, danger, buy, sell). Fills are chosen so this passes 4.5:1 in both modes.",
      "selection/row-hover": "Hover on a selected row. blue/75 and blue/850 sit between the ramp steps so every text color on rows still passes 4.5:1.",
      "surface/skeleton": "Loading placeholder bars. Decorative: pair with a loading label or aria-busy, never color alone.",
      "finance": "Buy (blue) / Sell (coral) are actions. Gain (green) / Loss (crimson red) are data. Never rely on color alone: pair with B/S labels, +/− signs, and ▲/▼ glyphs.",
      "status/critical": "Shares the crimson red ramp with finance/loss. Destructive (danger) buttons use status/critical, never finance/sell."
    },
    "surface/background":   { "Light": "{neutral/50}",  "Dark": "{neutral/900}" },
    "surface/panel":        { "Light": "{neutral/0}",   "Dark": "{neutral/800}" },
    "surface/raised":       { "Light": "{neutral/0}",   "Dark": "{neutral/750}" },
    "surface/hover":        { "Light": "{neutral/100}", "Dark": "{neutral/750}" },
    "surface/disabled":     { "Light": "{neutral/100}", "Dark": "{neutral/700}" },
    "surface/pressed":      { "Light": "{neutral/200}", "Dark": "{neutral/700}" },

    "border/default":       { "Light": "{neutral/200}", "Dark": "{neutral/700}" },
    "border/strong":        { "Light": "{neutral/500}", "Dark": "{neutral/400}" },

    "text/primary":         { "Light": "{neutral/900}", "Dark": "{neutral/50}" },
    "text/secondary":       { "Light": "{neutral/600}", "Dark": "{neutral/300}" },
    "text/disabled":        { "Light": "{neutral/400}", "Dark": "{neutral/500}" },
    "text/inverse":         { "Light": "{neutral/0}",   "Dark": "{neutral/900}" },

    "accent/default":       { "Light": "{blue/600}",    "Dark": "{blue/400}" },
    "accent/hover":         { "Light": "{blue/700}",    "Dark": "{blue/300}" },
    "accent/pressed":       { "Light": "{blue/800}",    "Dark": "{blue/200}" },
    "accent/subtle":        { "Light": "{blue/50}",     "Dark": "{blue/900}" },
    "focus/ring":           { "Light": "{blue/500}",    "Dark": "{blue/300}" },
    "selection/row":        { "Light": "{blue/50}",     "Dark": "{blue/900}" },
    "selection/row-hover":  { "Light": "{blue/75}",     "Dark": "{blue/850}" },
    "surface/skeleton":     { "Light": "{neutral/200}", "Dark": "{neutral/700}" },

    "status/positive":        { "Light": "{green/600}", "Dark": "{green/400}" },
    "status/positive-subtle": { "Light": "{green/50}",  "Dark": "{green/900}" },
    "status/positive-strong": { "Light": "{green/800}", "Dark": "{green/200}" },
    "status/warning":         { "Light": "{amber/600}", "Dark": "{amber/400}" },
    "status/warning-subtle":  { "Light": "{amber/50}",  "Dark": "{amber/900}" },
    "status/warning-strong":  { "Light": "{amber/800}", "Dark": "{amber/200}" },
    "status/critical":        { "Light": "{red/600}",   "Dark": "{red/300}" },
    "status/critical-hover":  { "Light": "{red/700}",   "Dark": "{red/200}" },
    "status/critical-pressed":{ "Light": "{red/800}",   "Dark": "{red/100}" },
    "status/critical-subtle": { "Light": "{red/50}",    "Dark": "{red/900}" },
    "status/critical-strong": { "Light": "{red/800}",   "Dark": "{red/200}" },
    "status/info":            { "Light": "{blue/600}",  "Dark": "{blue/400}" },
    "status/info-subtle":     { "Light": "{blue/50}",   "Dark": "{blue/900}" },
    "status/info-strong":     { "Light": "{blue/800}",  "Dark": "{blue/200}" },
    "status/neutral":         { "Light": "{neutral/500}", "Dark": "{neutral/400}" },
    "status/neutral-subtle":  { "Light": "{neutral/100}", "Dark": "{neutral/700}" },
    "status/neutral-strong":  { "Light": "{neutral/700}", "Dark": "{neutral/200}" },

    "finance/buy":          { "Light": "{blue/600}",   "Dark": "{blue/400}" },
    "finance/buy-subtle":   { "Light": "{blue/50}",    "Dark": "{blue/900}" },
    "finance/buy-strong":   { "Light": "{blue/800}",   "Dark": "{blue/200}" },
    "finance/sell":         { "Light": "{coral/600}",  "Dark": "{coral/400}" },
    "finance/sell-subtle":  { "Light": "{coral/50}",   "Dark": "{coral/900}" },
    "finance/sell-strong":  { "Light": "{coral/800}",  "Dark": "{coral/200}" },
    "finance/gain":         { "Light": "{green/600}",  "Dark": "{green/400}" },
    "finance/gain-subtle":  { "Light": "{green/50}",   "Dark": "{green/900}" },
    "finance/gain-strong":  { "Light": "{green/800}",  "Dark": "{green/200}" },
    "finance/loss":         { "Light": "{red/600}",    "Dark": "{red/300}" },
    "finance/loss-subtle":  { "Light": "{red/50}",     "Dark": "{red/900}" },
    "finance/loss-strong":  { "Light": "{red/800}",    "Dark": "{red/200}" }
  },

  "spacing": {
    "$notes": "Spacing scale for gap and padding (scope: Gap), plus corner radii (scope: Corner radius). Published: applied directly in layouts.",
    "space/0": 0,
    "space/2": 2,
    "space/4": 4,
    "space/6": 6,
    "space/8": 8,
    "space/12": 12,
    "space/16": 16,
    "space/24": 24,
    "space/32": 32,
    "space/48": 48,
    "radius/none": 0,
    "radius/xs": 2,
    "radius/sm": 4,
    "radius/md": 8,
    "radius/pill": 999
  },

  "size": {
    "$notes": "Dimension scale for fixed widths and heights (scope: Width & height). For heights that should follow Density, use Density/* instead.",
    "size/4": 4,
    "size/12": 12,
    "size/16": 16,
    "size/20": 20,
    "size/24": 24,
    "size/32": 32,
    "size/40": 40,
    "size/56": 56,
    "stroke/1": 1,
    "stroke/2": 2
  },

  "density": {
    "$modes": ["Compact", "Default", "Comfortable"],
    "$notes": "Every value is an alias to the Size or Spacing scale — never a raw number.",
    "row/height":           { "Compact": "{size/24}",  "Default": "{size/32}",  "Comfortable": "{size/40}" },
    "cell/padding-x":       { "Compact": "{space/6}",  "Default": "{space/8}",  "Comfortable": "{space/12}" },
    "cell/padding-y":       { "Compact": "{space/2}",  "Default": "{space/6}",  "Comfortable": "{space/8}" },
    "control/height":       { "Compact": "{size/24}",  "Default": "{size/32}",  "Comfortable": "{size/40}" },
    "control/padding-x":    { "Compact": "{space/8}",  "Default": "{space/12}", "Comfortable": "{space/16}" },
    "control/height-sm":    { "Compact": "{size/20}",  "Default": "{size/24}",  "Comfortable": "{size/32}" },
    "control/padding-x-sm": { "Compact": "{space/6}",  "Default": "{space/8}",  "Comfortable": "{space/12}" },
    "control/gap":          { "Compact": "{space/4}",  "Default": "{space/6}",  "Comfortable": "{space/8}" },
    "icon/size":            { "Compact": "{size/12}",  "Default": "{size/16}",  "Comfortable": "{size/16}" }
  },

  "typography": {
    "fontFamily": "Inter",
    "styles": {
      "Display":     { "fontSize": 24, "lineHeight": 32, "fontStyle": "Semi Bold", "letterSpacing": -0.5 },
      "Title":       { "fontSize": 20, "lineHeight": 28, "fontStyle": "Semi Bold", "letterSpacing": -0.25 },
      "Heading":     { "fontSize": 16, "lineHeight": 22, "fontStyle": "Semi Bold", "letterSpacing": 0 },
      "Body":        { "fontSize": 13, "lineHeight": 18, "fontStyle": "Regular",   "letterSpacing": 0 },
      "Body-strong": { "fontSize": 13, "lineHeight": 18, "fontStyle": "Semi Bold", "letterSpacing": 0 },
      "Label":       { "fontSize": 12, "lineHeight": 16, "fontStyle": "Medium",    "letterSpacing": 0 },
      "Caption":     { "fontSize": 11, "lineHeight": 14, "fontStyle": "Regular",   "letterSpacing": 0.1 },
      "Numeric":     { "fontSize": 13, "lineHeight": 18, "fontStyle": "Regular",   "letterSpacing": 0, "tabularFigures": true,
                       "description": "Intended for tabular figures: enable Type settings → Details → Numbers → Style → Monospace uppercase/lining (the plugin API cannot set this)." },
      "Code":        { "fontSize": 12, "lineHeight": 16, "fontStyle": "Regular",   "letterSpacing": 0, "fontFamily": "Roboto Mono" }
    }
  },

  "contrast": {
    "$notes": "Rules consumed by scripts/contrast-check.mjs. Each rule expands to every foreground × background pair, checked in every Color mode. Levels: body = 4.5:1, large = 3:1 (≥18px regular or ≥14px bold), ui = 3:1 (icons, borders, focus rings), exempt = reported only (disabled content, WCAG 1.4.3 exception).",
    "rules": [
      {
        "name": "Body text on surfaces",
        "level": "body",
        "foreground": ["text/primary", "text/secondary", "accent/default", "finance/buy", "finance/sell", "finance/gain", "finance/loss"],
        "background": ["surface/background", "surface/panel", "surface/raised", "surface/hover", "selection/row", "selection/row-hover"]
      },
      {
        "name": "Status text on surfaces (field errors, over-target notes)",
        "level": "body",
        "foreground": ["status/critical", "status/warning-strong"],
        "background": ["surface/background", "surface/panel", "surface/raised"]
      },
      {
        "name": "Text on pressed surfaces (pressed secondary/ghost buttons, filter chips)",
        "level": "body",
        "foreground": ["text/primary"],
        "background": ["surface/pressed"]
      },
      {
        "name": "Text on accent-tinted surfaces (selected tab count, bulk action bar)",
        "level": "body",
        "foreground": ["text/primary", "accent/default"],
        "background": ["accent/subtle"]
      },
      {
        "name": "UI graphics on interactive surfaces (focus ring, borders on hover/pressed and selected rows)",
        "level": "ui",
        "foreground": ["focus/ring", "border/strong"],
        "background": ["surface/hover", "surface/pressed", "selection/row", "selection/row-hover"]
      },
      {
        "name": "Warning and error cell borders on their tinted backgrounds",
        "level": "ui",
        "foreground": ["status/warning", "status/critical"],
        "background": ["status/warning-subtle", "status/critical-subtle"]
      },
      {
        "name": "Danger icon button glyph (row actions on any row background)",
        "level": "ui",
        "foreground": ["status/critical"],
        "background": ["surface/background", "surface/panel", "surface/hover", "selection/row", "selection/row-hover"]
      },
      {
        "name": "Gain and loss values in warning and error cells",
        "level": "body",
        "foreground": ["finance/gain-strong", "finance/loss-strong"],
        "background": ["status/warning-subtle", "status/critical-subtle"]
      },
      {
        "name": "Warning notes on selected rows (Needs sign-off)",
        "level": "body",
        "foreground": ["status/warning-strong"],
        "background": ["selection/row", "selection/row-hover"]
      },
      {
        "name": "Muted descriptions on selected options",
        "level": "body",
        "foreground": ["text/secondary"],
        "background": ["accent/subtle"]
      },
      {
        "name": "Links on hover",
        "level": "body",
        "foreground": ["accent/hover"],
        "background": ["surface/background", "surface/panel", "surface/raised"]
      },
      {
        "name": "Progress fills against the track",
        "level": "ui",
        "foreground": ["accent/default", "status/warning-strong"],
        "background": ["border/default"]
      },
      {
        "name": "Primary text in error cells",
        "level": "body",
        "foreground": ["text/primary", "text/secondary"],
        "background": ["status/critical-subtle", "status/warning-subtle"]
      },
      {
        "name": "Labels on solid fills (buttons, B/S tags)",
        "level": "body",
        "foreground": ["text/inverse"],
        "background": ["accent/default", "accent/hover", "accent/pressed", "status/critical", "status/critical-hover", "status/critical-pressed", "finance/buy", "finance/sell"]
      },
      { "name": "Positive chip",  "level": "body", "foreground": ["status/positive-strong"], "background": ["status/positive-subtle"] },
      { "name": "Warning chip",   "level": "body", "foreground": ["status/warning-strong"],  "background": ["status/warning-subtle"] },
      { "name": "Critical chip",  "level": "body", "foreground": ["status/critical-strong"], "background": ["status/critical-subtle"] },
      { "name": "Info chip",      "level": "body", "foreground": ["status/info-strong"],     "background": ["status/info-subtle"] },
      { "name": "Neutral chip",   "level": "body", "foreground": ["status/neutral-strong"],  "background": ["status/neutral-subtle"] },
      { "name": "Buy badge",      "level": "body", "foreground": ["finance/buy-strong"],     "background": ["finance/buy-subtle"] },
      { "name": "Sell badge",     "level": "body", "foreground": ["finance/sell-strong"],    "background": ["finance/sell-subtle"] },
      { "name": "Gain badge",     "level": "body", "foreground": ["finance/gain-strong"],    "background": ["finance/gain-subtle"] },
      { "name": "Loss badge",     "level": "body", "foreground": ["finance/loss-strong"],    "background": ["finance/loss-subtle"] },
      {
        "name": "UI graphics on surfaces (icons, input borders, focus ring)",
        "level": "ui",
        "foreground": ["border/strong", "focus/ring", "status/positive", "status/warning", "status/critical", "status/info", "status/neutral"],
        "background": ["surface/background", "surface/panel", "surface/raised"]
      },
      {
        "name": "Disabled content",
        "level": "exempt",
        "foreground": ["text/disabled"],
        "background": ["surface/panel", "surface/disabled"]
      }
    ]
  }
}
