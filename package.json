{
  "name": "sterling-design-system",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "description": "Sterling Design System: tokens, a Figma component library, and guidelines for data-dense applications. Fictional data only.",
  "type": "module",
  "scripts": {
    "contrast": "node scripts/contrast-check.mjs",
    "contrast:failures": "node scripts/contrast-check.mjs --failures-only",
    "check:tokens": "node scripts/check-tokens.mjs",
    "tokens:css": "node scripts/build-token-css.mjs",
    "tokens:site": "node scripts/build-token-site.mjs",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "check:parity": "npm --prefix ui run check:parity",
    "check:css": "npm --prefix ui run check:css",
    "check:a11y": "npm --prefix ui run build-storybook && npm --prefix ui run check:a11y",
    "check:docs": "npm --prefix ui run check:docs",
    "export:ai": "npm --prefix ui run export:ai",
    "check:ai": "npm --prefix ui run check:ai",
    "check:mcp": "npm --prefix mcp run typecheck && npm --prefix mcp test",
    "package": "npm --prefix ui run package",
    "check:demo-data": "npm --prefix ui run check:demo-data",
    "check:examples": "npm --prefix ui run check:examples",
    "check:urls": "npm --prefix ui run check:urls",
    "check:site": "npm --prefix ui run check:site",
    "check:excerpts": "npm --prefix ui run check:excerpts",
    "check:interactions": "npm --prefix ui run check:interactions",
    "check:release-date": "node scripts/check-release-date.mjs",
    "check:demo-session": "node scripts/check-demo-session.mjs",
    "docs:sync": "npm --prefix ui run docs:sync",
    "check:docs-sync": "npm --prefix ui run check:docs-sync",
    "diagrams": "node scripts/render-diagrams.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "demo:kit": "node scripts/build-demo-kit.mjs",
    "figma:fingerprint": "node scripts/figma-fingerprint.mjs",
    "storybook": "npm --prefix ui run storybook",
    "check:decks": "npm --prefix ui run check:decks --"
  }
}
