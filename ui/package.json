{
  "name": "sterling-ui",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "description": "Sterling in code: React components and Storybook documentation, built from the same tokens and component definitions as the Figma library.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "tokens": "node ../scripts/build-token-css.mjs src/styles/tokens.css",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p .",
    "check:parity": "tsx scripts/check-parity.ts",
    "check:css": "node scripts/check-css.mjs",
    "precheck:css": "npm run tokens",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:docs": "tsx scripts/check-docs.ts",
    "export:ai": "tsx scripts/export-ai.ts",
    "check:ai": "tsx scripts/check-ai.ts",
    "package": "node scripts/build-package.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:urls": "tsx scripts/check-urls.ts",
    "pages": "tsx scripts/build-pages.ts",
    "check:site": "node scripts/check-site.mjs",
    "check:excerpts": "tsx scripts/check-excerpts.ts",
    "check:interactions": "node scripts/check-interactions.mjs",
    "docs:sync": "tsx scripts/docs-sync.ts",
    "demo:extract": "tsx scripts/demo-extract.ts",
    "check:docs-sync": "tsx scripts/docs-sync.ts --check",
    "export:demo-data": "tsx scripts/export-demo-data.ts",
    "check:demo-data": "tsx scripts/export-demo-data.ts --check",
    "check:decks": "node scripts/check-decks.mjs"
  },
  "dependencies": {
    "inter-ui": "^3.19.3",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-dom": "^19.3.0",
    "react-stately": "^3.51.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "pdfjs-dist": "4.10.38",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "^10.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
