{
  "name": "sterling-plugin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local Figma plugin that generates Sterling from ../tokens/tokens.json. No network access.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/code.js --target=es2017 --log-level=warning",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/code.js --target=es2017 --watch",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
